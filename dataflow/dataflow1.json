{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "telemetry"
				},
				{
					"dataset": {
						"referenceName": "errors",
						"type": "DatasetReference"
					},
					"name": "errors"
				},
				{
					"dataset": {
						"referenceName": "failures",
						"type": "DatasetReference"
					},
					"name": "failures"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "errorToColumns"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "window1"
				},
				{
					"name": "pivot1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          datetime as timestamp,",
				"          machineID as integer,",
				"          volt as double,",
				"          rotate as double,",
				"          pressure as double,",
				"          vibration as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> telemetry",
				"source(output(",
				"          datetime as timestamp,",
				"          machineID as integer,",
				"          errorID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> errors",
				"source(output(",
				"          datetime as timestamp,",
				"          machineID as string,",
				"          errorID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> failures",
				"errors pivot(groupBy(datetime,",
				"          machineID),",
				"     pivotBy(errorID),",
				"     error = count(errorID),",
				"     columnNaming: '$N$V',",
				"     lateral: false) ~> errorToColumns",
				"telemetry, errorToColumns join(telemetry@datetime == errorToColumns@datetime",
				"     && telemetry@machineID == errorToColumns@machineID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          datetime = telemetry@datetime,",
				"          machineID = telemetry@machineID,",
				"          volt,",
				"          rotate,",
				"          pressure,",
				"          vibration,",
				"          datetime = errorToColumns@datetime,",
				"          machineID = errorToColumns@machineID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 window(asc(datetime, true),",
				"     startRowOffset: -3L,",
				"     endRowOffset: 0L,",
				"     mean_rotate_3h = mean(rotate),",
				"          mean_pressure_3h = mean(pressure),",
				"          mean_vibration_3h = mean(vibration),",
				"          mean_volt_3h = mean(volt),",
				"          stddev_volt_3h = stddev(volt),",
				"     rangeSpecified: true) ~> window1",
				"failures pivot(groupBy(machineID,",
				"          datetime),",
				"     columnNaming: '$N$V',",
				"     lateral: true) ~> pivot1"
			]
		}
	}
}